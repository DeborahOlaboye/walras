# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# Deployer key for testnet only. Use a throwaway wallet funded with Unichain
# Sepolia ETH, never a key that holds anything of value on mainnet.
PRIVATE_KEY=0x

# Optional — for `forge verify-contract` on Uniscan.
UNISCAN_API_KEY=
